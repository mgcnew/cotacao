# Supabase — valores públicos (vão para o browser)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Em produção, o domínio real — é ele que vai no link enviado ao fornecedor.
# Na Vercel dá para omitir: cai no domínio do projeto automaticamente.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — SEGREDO. Ignora RLS por completo.
# Usar somente em route handlers (src/app/api/**). Nunca prefixar com NEXT_PUBLIC_.
# Copie de: Dashboard > Project Settings > API Keys > secret key
SUPABASE_SECRET_KEY=

# Evolution API (WhatsApp) — necessário a partir da fase de envio de cotações
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
